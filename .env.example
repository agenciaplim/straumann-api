# Copie para `.env` e preencha. O `.env` é gitignored — nunca commitar.

# SMTP — envio de e-mail com os materiais
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Studio Neodent
SMTP_USE_TLS=true

# URL pública da API — usada para montar o link de download no e-mail
PUBLIC_URL=http://localhost:3006
