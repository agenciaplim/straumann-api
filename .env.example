# Copie para `.env` e preencha. O `.env` é gitignored — nunca commitar.

# Resend — envio de e-mail por API HTTP (o Render bloqueia SMTP de saída).
# Crie a key em https://resend.com (API Keys).
RESEND_API_KEY=
# Remetente. Em teste: "Studio Neodent <onboarding@resend.dev>".
# Em produção, após verificar o domínio no Resend: "...@neodent.com.br".
MAIL_FROM=Studio Neodent <onboarding@resend.dev>

# URL pública da API — usada no link de download que volta no status do job
PUBLIC_URL=http://localhost:3006
